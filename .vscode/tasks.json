{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Build Malloc's Library",
            "type": "shell",
            "command": "${workspaceFolder}\\build.bat",
            "args": ["debug"],
            "options": { "cwd": "${workspaceFolder}" },
            "problemMatcher": ["$msCompile"],
            "group": { "kind": "build", "isDefault": true }
        },
        {
            "label": "Build Malloc's Library (release)",
            "type": "shell",
            "command": "${workspaceFolder}\\build.bat",
            "options": { "cwd": "${workspaceFolder}" },
            "problemMatcher": ["$msCompile"],
            "group": "build"
        }
    ]
}
